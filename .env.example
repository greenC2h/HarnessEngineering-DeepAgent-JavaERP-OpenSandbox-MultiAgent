# MySQL 认证存储。复制为根目录 .env 后，在本地填写密码。
MYAGENT_AUTH_MYSQL_HOST=127.0.0.1
MYAGENT_AUTH_MYSQL_PORT=3306
MYAGENT_AUTH_MYSQL_DATABASE=myagent_auth
MYAGENT_AUTH_MYSQL_USER=root
MYAGENT_AUTH_MYSQL_PASSWORD=

# DeepSeek 模型服务
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# LangGraph PostgreSQL 持久化
DB_HOST=localhost
DB_PORT=5432
DB_NAME=langgraph_db
DB_USER=langgraph_user
DB_PASSWORD=
DB_SSLMODE=disable

# OpenSandbox 服务
OPEN_SANDBOX_API_KEY=
